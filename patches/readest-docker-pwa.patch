+  describe('iOS Web TTS silent audio ownership', () => {
+    let audioElements: HTMLAudioElement[];
+
+    beforeEach(() => {
+      vi.spyOn(navigator, 'userAgent', 'get').mockReturnValue(
+        'Mozilla/5.0 (iPhone; CPU iPhone OS 26_0 like Mac OS X)',
+      );
+      vi.spyOn(HTMLMediaElement.prototype, 'play').mockResolvedValue();
+      vi.spyOn(HTMLMediaElement.prototype, 'pause').mockImplementation(() => {});
+      vi.spyOn(HTMLMediaElement.prototype, 'load').mockImplementation(() => {});
+      releaseUnblockAudio();
+      audioElements = [];
+      const createElement = document.createElement.bind(document);
+      vi.spyOn(document, 'createElement').mockImplementation(((
+        tagName: string,
+        options?: ElementCreationOptions,
+      ) => {
+        const element = createElement(tagName, options);
+        if (tagName === 'audio') audioElements.push(element as HTMLAudioElement);
+        return element;
+      }) as typeof document.createElement);
+    });
+
+    afterEach(() => {
+      releaseUnblockAudio();
+    });
+
+    test('releases the silent audio when the remembered iOS voice is Web TTS', async () => {
+      vi.mocked(TTSUtils.getPreferredClient).mockReturnValueOnce('web');
+      unblockAudio();
+      const audio = audioElements[0]!;
+      expect(audio.src).not.toBe('');
+
+      await controller.init();
+
+      expect(controller.ttsClient).toBe(controller.ttsWebClient);
+      expect(audio.getAttribute('src')).toBe('');
+    });
+
+    test('restores silent audio when switching from iOS Web TTS to Edge', async () => {
+      controller.ttsEdgeVoices = [{ id: 'edge-voice-1', name: 'Edge', lang: 'ja-JP' }];
+      unblockAudio();
+      const previousAudio = audioElements[0]!;
+
+      await controller.setVoice('unknown-voice', 'ja');
+
+      expect(previousAudio.getAttribute('src')).toBe('');
+      await controller.setVoice('edge-voice-1', 'ja');
+      expect(controller.ttsClient).toBe(controller.ttsEdgeClient);
+      expect(audioElements).toHaveLength(2);
+      expect(audioElements[1]!.src).not.toBe('');
+    });
+
+    test('preserves silent audio for Web TTS on Windows', async () => {
+      vi.spyOn(navigator, 'userAgent', 'get').mockReturnValue(
+        'Mozilla/5.0 (Windows NT 10.0; Win64; x64)',
+      );
+      unblockAudio();
+      const audio = audioElements[0]!;
+
+      await controller.setVoice('unknown-voice', 'ja');
+
+      expect(audio.src).not.toBe('');
+    });
+  });
+
