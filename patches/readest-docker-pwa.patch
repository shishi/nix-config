+describe('WebSpeechClient Android locale voices', () => {
+  test.each([
+    ['ja', 'Japanese Japan', 'ja_JP'],
+    ['en-US', 'English United States', 'en_US'],
+  ])('offers Android voices for %s books', async (bookLang, name, voiceLang) => {
+    const androidVoices = [
+      makeVoice('Japanese Japan', 'ja_JP'),
+      makeVoice('English United States', 'en_US'),
+    ];
+    Object.defineProperty(window, 'speechSynthesis', {
+      value: {
+        getVoices: () => androidVoices,
+        cancel: vi.fn(),
+        pause: vi.fn(),
+        resume: vi.fn(),
+        speak: vi.fn(),
+      },
+      configurable: true,
+    });
+    const client = new WebSpeechClient();
+    await client.init();
+
+    const groups = await client.getVoices(bookLang);
+
+    expect(groups[0]!.disabled).toBe(false);
+    expect(groups[0]!.voices.map((voice) => voice.name)).toEqual([name]);
+    expect(await client.getWebSpeechVoiceFromLang(bookLang)).toBe(
+      androidVoices.find((voice) => voice.lang === voiceLang),
+    );
+  });
+});
