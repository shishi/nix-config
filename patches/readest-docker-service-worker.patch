diff --git a/Dockerfile b/Dockerfile
index a29567cba..3f01b940b 100644
--- a/Dockerfile
+++ b/Dockerfile
@@ -49,7 +49,11 @@ WORKDIR /app/apps/readest-app
 # next.config.mjs gates `output: 'standalone'` on BUILD_STANDALONE so other
 # web builds keep their default output.
 ENV BUILD_STANDALONE=true
-RUN pnpm build-web
+# @serwist/next only emits the service worker (public/sw.js) from a webpack
+# build, so switch `next build` to webpack as `pnpm deploy` does. The webpack
+# build runs out of memory with Node's default heap; give it the 8 GB the
+# release workflows use.
+RUN pnpm patch-build-webpack && NODE_OPTIONS=--max-old-space-size=8192 pnpm build-web
 
 # Production runtime ships only the standalone server, its traced node_modules,
 # and the static/public assets — no pnpm, no source tree, no dev dependencies,
diff --git a/apps/readest-app/src/__tests__/docker-image-build.test.ts b/apps/readest-app/src/__tests__/docker-image-build.test.ts
new file mode 100644
index 000000000..6f7a06c59
--- /dev/null
+++ b/apps/readest-app/src/__tests__/docker-image-build.test.ts
@@ -0,0 +1,26 @@
+// @vitest-environment node
+import { readFileSync } from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { describe, expect, test } from 'vitest';
+
+const repoRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../../../..');
+const dockerfile = readFileSync(path.join(repoRoot, 'Dockerfile'), 'utf8');
+
+describe('Docker image build', () => {
+  /**
+   * @serwist/next only writes the service worker (`public/sw.js`) from a
+   * webpack build, and `next build` uses Turbopack by default. Built with plain
+   * `pnpm build-web`, the image has no service worker, so the self-hosted web
+   * app can't load offline or work as an offline PWA.
+   */
+  test('builds the web app with webpack so the image has a service worker', () => {
+    const buildWeb = dockerfile
+      .replace(/\\\n\s*/g, '')
+      .split('\n')
+      .find((line) => line.startsWith('RUN ') && line.includes('pnpm build-web'));
+
+    expect(buildWeb, 'the Dockerfile builds the web app').toBeDefined();
+    expect(buildWeb).toMatch(/^RUN pnpm patch-build-webpack && /);
+  });
+});
